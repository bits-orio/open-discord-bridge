# Open Discord Bridge — example config (MVP, Local transport only).
# Copy to bridge.yaml and edit. Secrets come from env vars, never this file.

factorio:
  rcon:
    address: 127.0.0.1:27015
    password_env: FACTORIO_RCON_PASSWORD
  # Path to the JSONL the companion mod writes (local path, or remote path for sftp).
  # Supports ${ENV} and a leading ~/.
  events_file: ${HOME}/factorio/script-output/open-discord-bridge/events.jsonl

  # Only used when transport is "sftp" (bridge on separate infra from Factorio).
  # sftp:
  #   host: game-host:22
  #   user: factorio-bridge
  #   key_path: /secrets/bridge_ed25519     # or set a password via password_env
  #   password_env: SFTP_PASSWORD
  #   known_hosts_path: /secrets/known_hosts # omit to skip host-key verification (logs a warning)

transport: local        # local | sftp  (inbound is always RCON)
poll_interval: 1s

discord:
  token_env: DISCORD_BOT_TOKEN
  guild_id: "000000000000000000"
  embed: false              # true = events as colored embeds (chat stays plain text;
                            # "chat" = any event keyed chat or <namespace>.chat)
  announce_status: true     # true = post "established"/"disconnected" when the bridge's
                            # link to Factorio (RCON + mod handshake) changes. Routed like
                            # any event under "bridge.*" — needs a matching route (e.g. "*").
  # First matching route wins. Patterns: exact ("vanilla.chat"),
  # namespace glob ("mts.*"), or catch-all ("*").
  # Every channel listed here also accepts Discord messages back into the game.
  routes:
    - source: "vanilla.chat"
      channel_id: "111111111111111111"
    - source: "*"
      channel_id: "111111111111111111"
  # Who counts as a Discord admin (for admin-only commands). A user is admin if their ID
  # is in `users`, OR they hold a role in `roles`, OR (default) they have Discord's
  # Administrator permission. Set use_discord_permission: false to require the lists.
  admins:
    roles: []   # role IDs, e.g. ["112233445566778899"]
    users: []   # user IDs
    # use_discord_permission: true

  # Discord -> RCON commands. A message whose first word matches `trigger` runs `rcon`
  # and posts the reply. Public by default; set `admin: true` to restrict to admins.
  # `rcon` may be multiline (a /silent-command script).
  commands:
    - trigger: "!players"
      rcon: "/players online"

    - trigger: "!link"           # link a Discord account to an in-game player
      args: true                 # in-game run /odb-link to get CODE, then "!link CODE"
      rcon: "/odb-confirm-link {1} {userid} {user}"

    - trigger: "!unlink"         # unlink your own Discord account (no args needed)
      args: true                 # uses {userid} only -> no typed argument required
      rcon: "/odb-unlink-discord {userid}"

    - trigger: "!links"          # admin: list all links
      admin: true
      rcon: "/odb-links"

    - trigger: "!unlink-player"  # admin: unlink a specific player
      admin: true
      args: true
      rcon: "/odb-unlink-player {args}"

    - trigger: "!unlink-all"     # admin: clear all links
      admin: true
      rcon: "/odb-unlink-all"

    - trigger: "!kick"           # admin-only, takes an argument
      admin: true
      args: true                 # interpolate {1}/{args}/{user} from the message
      rcon: "/kick {1}"          # "!kick Bob" -> "/kick Bob"

    - trigger: "!cleanup"        # multiline script example
      admin: true
      rcon: |
        /silent-command
        local n = 0
        for _, e in pairs(game.surfaces[1].find_entities_filtered{name="item-on-ground"}) do
          e.destroy(); n = n + 1
        end
        rcon.print("removed " .. n .. " ground items")

# Open HTTP Control API (off by default). Any portal/CLI integrates against the same
# spec — see pkg/controlapi/spec/openapi.yaml. Bind to loopback unless you front it
# with TLS + a tunnel.
control_api:
  enabled: false
  listen: 127.0.0.1:7777
  auth_token_env: BRIDGE_CONTROL_TOKEN
