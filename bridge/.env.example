# Copy to .env (or export these) before running the bridge.
# These are the secrets referenced by bridge.yaml's *_env fields.

DISCORD_BOT_TOKEN=your-discord-bot-token
FACTORIO_RCON_PASSWORD=your-rcon-password

# Only needed if control_api.enabled is true in bridge.yaml.
BRIDGE_CONTROL_TOKEN=a-long-random-secret
